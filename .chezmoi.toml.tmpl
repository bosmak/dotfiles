[edit]
  command = {{ if .chezmoi.config.edit.command }}{{ .chezmoi.config.edit.command | quote }}{{ else }}{{ promptString "Default editor" "vim" | quote }}{{ end }}

[git]
  autoCommit = false
  autoPush = false

[data]
  role = {{ if hasKey . "role" }}{{ .role | quote }}{{ else }}{{ promptChoice "Role" (list "personal" "work") "personal" | quote }}{{ end }}
  email = {{ if hasKey . "email" }}{{ .email | quote }}{{ else }}{{ promptString "Email" | quote }}{{ end }}
  name = {{ if hasKey . "name" }}{{ .name | quote }}{{ else }}{{ promptString "Name" | quote }}{{ end }}
  playbook = {{ if hasKey . "playbook" }}{{ .playbook | quote }}{{ else }}{{ promptChoice "Ansible playbook" (list "default" "none") "default" | quote }}{{ end }}
