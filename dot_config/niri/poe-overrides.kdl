// PoE-specific overrides — included after all DMS rules so these win.
window-rule {
    match app-id=r#"^steam_app_238960$"#
    open-on-output "DP-2"
    open-floating false
    open-fullscreen false
    default-column-width { fixed 2560; }
    default-window-height { fixed 1080; }
    min-height 1080
    max-height 1080
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
}
