# ~/.config/dots/dank-palette.zsh
#
# DankMaterialShell palette integration
# -------------------------------------
# Reads ~/.cache/DankMaterialShell/dms-colors.json (regenerated by matugen
# whenever the wallpaper or source color changes) and applies the palette to
# fzf-tab, zsh-syntax-highlighting, zsh-autosuggestions,
# history-substring-search, Starship, and the terminal background (OSC 11;
# honored by Ghostty/kitty/foot, no-op elsewhere).
#
# Falls back to a built-in Material You rose palette when the JSON is
# missing, jq is unavailable, or any required value fails to parse.
#
# Source this from ~/.zshrc after plugins are plugged and before
# `eval "$(starship init zsh)"` so the first prompt reads the freshly
# written config:
#
#   source "${XDG_CONFIG_HOME:-$HOME/.config}/dots/dank-palette.zsh"
#
# Manual refresh: `reload-theme`

DMS_COLORS_JSON="${XDG_CACHE_HOME:-$HOME/.cache}/DankMaterialShell/dms-colors.json"
DMS_STARSHIP="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
DMS_STARSHIP_BAK="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml.dankbackup"
DMS_LAST_MTIME="0"

load_dank_palette() {
  # --- fast path: skip if the palette source hasn't changed ---
  local state
  if [[ -r "$DMS_COLORS_JSON" ]] && command -v jq >/dev/null 2>&1; then
    state=$(stat -c %Y "$DMS_COLORS_JSON" 2>/dev/null \
            || stat -f %m "$DMS_COLORS_JSON" 2>/dev/null)
    [[ -z "$state" ]] && state="__no_json__"
  else
    state="__no_json__"
  fi
  [[ "$state" == "$DMS_LAST_MTIME" ]] && return 0
  DMS_LAST_MTIME="$state"

  # --- defaults (rose/pink Material You) used when JSON or jq is unavailable ---
  local mode="dark"
  local c0="#191112" c1="#ff1818" c2="#51e91e" c3="#ffcc0a" c4="#f52f5d"
  local c5="#4a0e2f" c6="#e91e63" c7="#f4dbe9" c8="#4d3e46" c9="#ff585f"
  local c10="#8aff63" c11="#ffde63" c12="#ff4282" c13="#ff6398" c14="#ff9bbd" c15="#fff3fa"
  local m_primary="#e91e63" m_on_primary="#000000" m_primary_container="#4a0e2f"
  local m_secondary="#f8bbd9" m_tertiary="#f8bbd9" m_surface="#191112"
  local m_on_surface="#f0dee0" m_on_surface_variant="#d6c2c3"
  local m_surface_variant="#524345" m_outline="#9f8c8e" m_outline_variant="#524345"
  local m_error="#f2b8b5" m_background="#191112" m_surface_container="#261d1e"

  # --- override from JSON if possible ---
  if [[ "$state" != "__no_json__" ]]; then
    local _mode _c0 _c1 _c2 _c3 _c4 _c5 _c6 _c7 _c8 _c9 _c10 _c11 _c12 _c13 _c14 _c15
    local _primary _on_primary _primary_container _secondary _tertiary
    local _surface _on_surface _on_surface_variant _surface_variant
    local _outline _outline_variant _error _background _surface_container

    _mode=$(jq -r '.mode // "dark"' "$DMS_COLORS_JSON" 2>/dev/null)
    [[ -z "$_mode" || "$_mode" == "null" ]] && _mode="dark"

    _c0=$(jq -r  --arg m "$_mode" '.dank16.color0[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c1=$(jq -r  --arg m "$_mode" '.dank16.color1[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c2=$(jq -r  --arg m "$_mode" '.dank16.color2[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c3=$(jq -r  --arg m "$_mode" '.dank16.color3[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c4=$(jq -r  --arg m "$_mode" '.dank16.color4[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c5=$(jq -r  --arg m "$_mode" '.dank16.color5[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c6=$(jq -r  --arg m "$_mode" '.dank16.color6[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c7=$(jq -r  --arg m "$_mode" '.dank16.color7[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c8=$(jq -r  --arg m "$_mode" '.dank16.color8[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c9=$(jq -r  --arg m "$_mode" '.dank16.color9[$m]  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c10=$(jq -r --arg m "$_mode" '.dank16.color10[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c11=$(jq -r --arg m "$_mode" '.dank16.color11[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c12=$(jq -r --arg m "$_mode" '.dank16.color12[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c13=$(jq -r --arg m "$_mode" '.dank16.color13[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c14=$(jq -r --arg m "$_mode" '.dank16.color14[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _c15=$(jq -r --arg m "$_mode" '.dank16.color15[$m] // ""' "$DMS_COLORS_JSON" 2>/dev/null)

    _primary=$(jq -r            --arg m "$_mode" '.colors[$m].primary            // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _on_primary=$(jq -r         --arg m "$_mode" '.colors[$m].on_primary         // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _primary_container=$(jq -r  --arg m "$_mode" '.colors[$m].primary_container  // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _secondary=$(jq -r          --arg m "$_mode" '.colors[$m].secondary          // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _tertiary=$(jq -r           --arg m "$_mode" '.colors[$m].tertiary           // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _surface=$(jq -r            --arg m "$_mode" '.colors[$m].surface            // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _on_surface=$(jq -r         --arg m "$_mode" '.colors[$m].on_surface         // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _on_surface_variant=$(jq -r --arg m "$_mode" '.colors[$m].on_surface_variant // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _surface_variant=$(jq -r    --arg m "$_mode" '.colors[$m].surface_variant    // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _outline=$(jq -r            --arg m "$_mode" '.colors[$m].outline            // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _outline_variant=$(jq -r    --arg m "$_mode" '.colors[$m].outline_variant    // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _error=$(jq -r              --arg m "$_mode" '.colors[$m].error              // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _background=$(jq -r         --arg m "$_mode" '.colors[$m].background         // ""' "$DMS_COLORS_JSON" 2>/dev/null)
    _surface_container=$(jq -r  --arg m "$_mode" '.colors[$m].surface_container  // ""' "$DMS_COLORS_JSON" 2>/dev/null)

    # only commit JSON values if we got the essentials; otherwise stay on defaults
    if [[ -n "$_c0" && -n "$_primary" && -n "$_background" ]]; then
      mode="$_mode"
      c0="$_c0" c1="$_c1" c2="$_c2" c3="$_c3" c4="$_c4"
      c5="$_c5" c6="$_c6" c7="$_c7" c8="$_c8" c9="$_c9"
      c10="$_c10" c11="$_c11" c12="$_c12" c13="$_c13" c14="$_c14" c15="$_c15"
      m_primary="$_primary" m_on_primary="$_on_primary"
      m_primary_container="$_primary_container"
      m_secondary="$_secondary" m_tertiary="$_tertiary"
      m_surface="$_surface" m_on_surface="$_on_surface"
      m_on_surface_variant="$_on_surface_variant"
      m_surface_variant="$_surface_variant"
      m_outline="$_outline" m_outline_variant="$_outline_variant"
      m_error="$_error" m_background="$_background"
      m_surface_container="$_surface_container"
    fi
  fi

  # --- export so any subprocess / script can consume the palette ---
  export DANK_MODE="$mode"
  export DANK_C0="$c0" DANK_C1="$c1" DANK_C2="$c2" DANK_C3="$c3" DANK_C4="$c4"
  export DANK_C5="$c5" DANK_C6="$c6" DANK_C7="$c7" DANK_C8="$c8" DANK_C9="$c9"
  export DANK_C10="$c10" DANK_C11="$c11" DANK_C12="$c12" DANK_C13="$c13"
  export DANK_C14="$c14" DANK_C15="$c15"
  export DANK_PRIMARY="$m_primary" DANK_ON_PRIMARY="$m_on_primary"
  export DANK_PRIMARY_CONTAINER="$m_primary_container"
  export DANK_SECONDARY="$m_secondary" DANK_TERTIARY="$m_tertiary"
  export DANK_SURFACE="$m_surface" DANK_ON_SURFACE="$m_on_surface"
  export DANK_ON_SURFACE_VARIANT="$m_on_surface_variant"
  export DANK_SURFACE_VARIANT="$m_surface_variant" DANK_OUTLINE="$m_outline"
  export DANK_OUTLINE_VARIANT="$m_outline_variant" DANK_ERROR="$m_error"
  export DANK_BACKGROUND="$m_background" DANK_SURFACE_CONTAINER="$m_surface_container"

  # --- fzf-tab: rebuild the --color arg list (preserves the layout flags) ---
  # Note: fzf does NOT have an `underline` color slot; matched-char underlines
  # follow the `hl` color. Use warm dank16 accents for pointer/marker so they
  # stay distinct from each other and from the hl color regardless of source.
  zstyle ':fzf-tab:*' fzf-flags \
    --height=50% --layout=reverse --info=inline --no-border --no-separator \
    --color="hl:$c6" \
    --color="hl+:$c12" \
    --color="fg:$m_on_surface" \
    --color="fg+:$m_on_surface" \
    --color="bg:$m_surface" \
    --color="bg+:$m_surface_container" \
    --color="header:$m_on_surface_variant" \
    --color="info:$m_outline" \
    --color="pointer:$c3" \
    --color="marker:$c1" \
    --color="prompt:$c6" \
    --color="spinner:$c3" \
    --color="gutter:$m_surface_variant" \
    --color="query:$m_on_surface" \
    --color="border:$m_outline_variant" \
    --color="scrollbar:$m_outline_variant" \
    --color="label:$m_on_surface_variant"

  # --- zsh-syntax-highlighting ---
  # Use the warm dank16 accents (c1, c3) so different token types stay visually
  # distinct from the primary accent and from each other.
  ZSH_HIGHLIGHT_STYLES[default]='fg='"$m_on_surface"
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg='"$m_error"',underline'
  ZSH_HIGHLIGHT_STYLES[reserved-word]='fg='"$c3"',bold'
  ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg='"$c1"',underline'
  ZSH_HIGHLIGHT_STYLES[precommand]='fg='"$m_primary"',bold'
  ZSH_HIGHLIGHT_STYLES[commandseparator]='fg='"$m_outline"
  ZSH_HIGHLIGHT_STYLES[path]='fg='"$c1"',underline'
  ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg='"$m_outline"
  ZSH_HIGHLIGHT_STYLES[path_prefix]='fg='"$m_outline"
  ZSH_HIGHLIGHT_STYLES[globbing]='fg='"$c3"
  ZSH_HIGHLIGHT_STYLES[history-expansion]='fg='"$m_outline"
  ZSH_HIGHLIGHT_STYLES[command-substitution]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[command-substitution-delimited]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[process-substitution]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[arithmetic-expansion]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimited]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg='"$m_on_surface_variant"
  ZSH_HIGHLIGHT_STYLES[assign]='fg='"$m_secondary"
  ZSH_HIGHLIGHT_STYLES[redirection]='fg='"$c3"',bold'
  ZSH_HIGHLIGHT_STYLES[comment]='fg='"$m_outline"',italic'
  ZSH_HIGHLIGHT_STYLES[arg0]='fg='"$m_primary"',bold'

  # --- zsh-autosuggestions ---
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=$m_on_surface_variant"
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)

  # --- history-substring-search (read by zsh-syntax-highlighting at runtime) ---
  ZSH_HIGHLIGHT_SEARCH_BUFFER_DIRTY="bg=$m_surface_variant,fg=$c3,bold"
  ZSH_HIGHLIGHT_SEARCH_BUFFER_CLEAN="bg=$m_surface_container,fg=$m_on_surface"
  ZSH_HIGHLIGHT_SEARCH_BUFFER_GLOBAL="bg=$m_primary_container,fg=$c6,bold"
  ZSH_HIGHLIGHT_SEARCH_BUFFER_UNAMBIGUOUS="bg=$m_surface_variant,fg=$m_on_surface,bold"

  # --- Starship: regenerate a palette-aware config (preserves original structure) ---
  if [[ ! -f "$DMS_STARSHIP_BAK" && -f "$DMS_STARSHIP" ]]; then
    cp "$DMS_STARSHIP" "$DMS_STARSHIP_BAK"
  fi
  local _tmp="${DMS_STARSHIP}.dank.$$"
  cat > "$_tmp" <<'STARSHEOF'
# wezm+ style for Starship
# Regenerated by load_dank_palette from @@JSON@@ (mode=@@MODE@@).
# The original is at @@BAK@@.
# Edit the template in ~/.config/dots/dank-palette.zsh instead.
add_newline = false

format = "$username$hostname$git_branch $status [$character](@@C6@@ bold) "
right_format = "$directory"

[username]
format = "[@@USER@@](@@C6@@ bold)"
show_always = true

[hostname]
format = "[@@HOSTNAME@@](@@C3@@ bold)"
ssh_only = false

[git_branch]
format = " [$branch](@@C1@@ italic)"

[directory]
format = "[$path](@@ON_SURFACE_VARIANT@@)"
truncation_length = 0
truncate_to_repo = false
truncation_symbol = "…/"
home_symbol = "~"

[character]
success_symbol = "%"
error_symbol = "#"
format = "[$symbol](@@C6@@ bold)"

[git_status]
disabled = true

[status]
disabled = false
format = '[\[$status\]](@@ON_SURFACE_VARIANT@@ bold)'
STARSHEOF

  sed -i \
    -e "s|@@JSON@@|$DMS_COLORS_JSON|g" \
    -e "s|@@MODE@@|$mode|g" \
    -e "s|@@BAK@@|$DMS_STARSHIP_BAK|g" \
    -e "s|@@USER@@|$USER|g" \
    -e "s|@@HOSTNAME@@|$HOST|g" \
    -e "s|@@C1@@|$c1|g" \
    -e "s|@@C3@@|$c3|g" \
    -e "s|@@C6@@|$c6|g" \
    -e "s|@@ON_SURFACE_VARIANT@@|$m_on_surface_variant|g" \
    "$_tmp"
  mv -f "$_tmp" "$DMS_STARSHIP"

  # --- Terminal background via OSC 11 (Ghostty/kitty/foot honor this) ---
  [[ -t 1 ]] && printf '\033]11;%s\007' "$m_background"
}

# Initial load (must run after plugins are plugged so the highlight
# style arrays exist, and before starship init so the first prompt
# reads the freshly written config).
load_dank_palette

# Re-check the JSON mtime before each prompt render. If matugen
# regenerated the palette (wallpaper/source color changed), reload
# styles and rewrite starship.toml. The precmd order here is:
#   1. _dank_precmd_reload (added below)  -> updates config if mtime changed
#   2. _starship_precmd   (added by starship init) -> renders with the new config
# so we must register our hook before `eval "$(starship init zsh)"`.
_dank_precmd_reload() {
  [[ -r "$DMS_COLORS_JSON" ]] || return 0
  local mtime
  mtime=$(stat -c %Y "$DMS_COLORS_JSON" 2>/dev/null \
          || stat -f %m "$DMS_COLORS_JSON" 2>/dev/null) || return 0
  [[ -n "$mtime" && "$mtime" != "$DMS_LAST_MTIME" ]] && load_dank_palette
}
autoload -U add-zsh-hook 2>/dev/null
add-zsh-hook precmd _dank_precmd_reload

# Manual refresh
alias reload-theme='load_dank_palette && echo "dank-palette: reloaded (mode=$DANK_MODE)"'
