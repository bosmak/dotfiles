[Desktop Entry]
Name=Whatsie
GenericName=WhatsApp Web Client
Comment=A WhatsApp Web client built with Qt WebEngine
Icon=com.ktechpit.whatsie
Exec=/home/bsmk/.config/autostart/com.ktechpit.whatsie.ignition_delay.sh
Terminal=false
Type=Application
Categories=Network;InstantMessaging;Chat;Qt;
Keywords=Whatsie;WhatsApp;Chat;Messaging;
StartupWMClass=whatsie
StartupNotify=true
MimeType=x-scheme-handler/whatsapp;
X-GNOME-UsesNotifications=true
Actions=NewChat;Settings;
X-Flatpak=com.ktechpit.whatsie
Hidden=true

[Desktop Action NewChat]
Name=New chat
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=whatsie com.ktechpit.whatsie --new-chat

[Desktop Action Settings]
Name=Settings
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=whatsie com.ktechpit.whatsie --settings
