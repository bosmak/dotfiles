#!/usr/bin/env bash
# Installs the prereqs the apply needs: git and curl for the checkout,
# jq for the niri scripts, gum for the prompts, ansible-core for the
# playbook. Runs before every apply; the packages are installed one at a
# time so an unavailable one does not abort the rest.
#
# mise is deliberately not in this list: it ships from the jdxcode COPR,
# which the ansible playbook enables, so the playbook owns it.
# Prereqs hash: {{ output "bash" "-c" "printf '%s\n' git curl jq gum ansible-core | sha256sum | cut -d' ' -f1" | trim }}

set -euo pipefail

CONFIG="$HOME/.config/chezmoi/chezmoi.toml"
if [ ! -f "$CONFIG" ]; then
    echo "ERROR: $CONFIG is missing — run 'chezmoi init --apply' to create it" >&2
    exit 1
fi

if [[ ! -r /dev/tty ]] 2>/dev/null; then
    exit 0
fi

case "$(uname -s)" in
    Darwin) INSTALL=(brew install) ;;
    *) INSTALL=(sudo dnf install -y) ;;
esac

declare -A PKG_BIN=(
    [ansible-core]=ansible-playbook
)

NEED_INSTALL=()
for pkg in git curl jq gum ansible-core; do
    bin="${PKG_BIN[$pkg]:-$pkg}"
    if ! command -v "$bin" >/dev/null 2>&1; then
        NEED_INSTALL+=("$pkg")
    fi
done

if [ ${#NEED_INSTALL[@]} -eq 0 ]; then
    exit 0
fi

echo "==> Installing missing prereqs: ${NEED_INSTALL[*]}"
for pkg in "${NEED_INSTALL[@]}"; do
    "${INSTALL[@]}" "$pkg" || echo "WARN: could not install $pkg" >&2
done
