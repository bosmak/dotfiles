#!/usr/bin/env bash
# Installs the prereqs the apply needs, one package at a time so an
# unavailable one does not abort the rest.
#
# mise is deliberately absent: it ships from the jdxcode COPR, which the
# ansible playbook enables, so the playbook owns it.
# Prereqs hash: {{ output "bash" "-c" "printf '%s\n' git curl jq gum ansible-core | sha256sum | cut -d' ' -f1" | trim }}

set -euo pipefail

if [[ ! -r /dev/tty ]] 2>/dev/null; then
    exit 0
fi

case "$(uname -s)" in
    Darwin) INSTALL=(brew install) ;;
    *) INSTALL=(sudo dnf install -y) ;;
esac

declare -A PKG_BIN=(
    [ansible-core]=ansible-playbook
)

NEED_INSTALL=()
for pkg in git curl jq gum ansible-core; do
    bin="${PKG_BIN[$pkg]:-$pkg}"
    if ! command -v "$bin" >/dev/null 2>&1; then
        NEED_INSTALL+=("$pkg")
    fi
done

if [ ${#NEED_INSTALL[@]} -eq 0 ]; then
    exit 0
fi

echo "==> Installing missing prereqs: ${NEED_INSTALL[*]}"
for pkg in "${NEED_INSTALL[@]}"; do
    "${INSTALL[@]}" "$pkg" || echo "WARN: could not install $pkg" >&2
done
