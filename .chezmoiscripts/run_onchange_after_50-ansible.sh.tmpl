#!/usr/bin/env bash
# Re-runs the ansible playbook whenever files under ansible/ change. The
# hash below is recomputed at every apply; when it differs from the
# previously rendered content, chezmoi re-executes this script.
# Ansible tree hash: {{ output "bash" "-c" (printf "cd %s && find ansible -type f -not -path '*/.ansible/*' -not -path '*/__pycache__/*' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1" .chezmoi.sourceDir) | trim }}

set -euo pipefail

ANSIBLE_DIR="{{ .chezmoi.sourceDir }}/ansible"
DEFAULT_PLAYBOOK="default"

if ! command -v ansible-playbook >/dev/null 2>&1; then
    echo "ansible-playbook not found; skipping (run tools/chezmoi-init.sh to install prereqs)"
    exit 0
fi

if [[ ! -d "$ANSIBLE_DIR" ]]; then
    echo "ansible/ not found at $ANSIBLE_DIR; skipping"
    exit 0
fi

# Layer identity. The system layer follows the os-release ID (the same name
# the layer files use) and the profile layer follows the role, so the playbook
# carries neither in its name. An empty system id falls back to the ansible
# distribution fact.
SYSTEM_ID="{{ if hasKey .chezmoi "osRelease" }}{{ .chezmoi.osRelease.id }}{{ end }}"
PROFILE="{{ if hasKey . "role" }}{{ .role }}{{ else }}personal{{ end }}"

# Playbook selection: the "playbook" key holds a basename (without .yml) from
# ansible/playbooks/, or "none" to skip ansible. An unset key falls back to
# the legacy <os>-<role> name and then to the default playbook; a configured
# name that no longer exists falls back to the default playbook too.
PLAYBOOK_NAME="{{ if hasKey . "playbook" }}{{ .playbook }}{{ end }}"
PLAYBOOK=""

if [[ -z "$PLAYBOOK_NAME" ]]; then
    for candidate in "${SYSTEM_ID}-${PROFILE}" "$DEFAULT_PLAYBOOK"; do
        if [[ -f "$ANSIBLE_DIR/playbooks/${candidate}.yml" ]]; then
            PLAYBOOK="$ANSIBLE_DIR/playbooks/${candidate}.yml"
            break
        fi
    done
elif [[ "$PLAYBOOK_NAME" == "none" ]]; then
    echo "==> playbook=none in chezmoi.toml; skipping ansible"
    exit 0
elif [[ -f "$ANSIBLE_DIR/playbooks/${PLAYBOOK_NAME}.yml" ]]; then
    PLAYBOOK="$ANSIBLE_DIR/playbooks/${PLAYBOOK_NAME}.yml"
else
    echo "==> Playbook '$PLAYBOOK_NAME' not found; falling back to '$DEFAULT_PLAYBOOK'"
    if [[ -f "$ANSIBLE_DIR/playbooks/${DEFAULT_PLAYBOOK}.yml" ]]; then
        PLAYBOOK="$ANSIBLE_DIR/playbooks/${DEFAULT_PLAYBOOK}.yml"
    fi
fi

if [[ -z "$PLAYBOOK" ]]; then
    echo "Playbook not found: no playbook available (skipping)"
    exit 0
fi

# No --ask-become-pass: sudo authenticates through PAM on the terminal, so
# the fingerprint reader answers the prompt.

# Machine identity is not passed in: the playbook reads the ansible_hostname
# fact, so the machine layer follows the host it runs on.

# The installer role needs the collections in requirements.yml; the galaxy
# install is a no-op when they are already present. It runs as root,
# because the playbook does.
if [ -f "$ANSIBLE_DIR/requirements.yml" ]; then
    sudo ansible-galaxy collection install -r "$ANSIBLE_DIR/requirements.yml" \
        || echo "WARN: could not install the ansible collections" >&2
fi

ANSIBLE_EXTRA_VARS=(-e "profile=$PROFILE")
if [[ -n "$SYSTEM_ID" ]]; then
    ANSIBLE_EXTRA_VARS+=(-e "system_id=$SYSTEM_ID")
fi

echo "==> Running ansible: $PLAYBOOK (system: ${SYSTEM_ID:-auto}, profile: $PROFILE)"

# The fingerprint prompt is printed by sudo on the terminal, so the
# playbook needs one to show it.
if ! ( : < /dev/tty ) 2>/dev/null; then
    echo "==> No terminal attached; skipping ansible (the prompt needs one)" >&2
    exit 0
fi

# One sudo for the whole playbook.
#
# The playbook runs as root, so the tasks that need root are already
# root and the ones that belong to the account drop to it explicitly.
# Nothing authenticates twice, and no credential is cached: sudo keeps
# its per-terminal record, and closing the terminal takes it away.
(cd "$ANSIBLE_DIR" && sudo ansible-playbook \
    -e "login_user=$USER" \
    "${ANSIBLE_EXTRA_VARS[@]}" \
    "${PLAYBOOK#"$ANSIBLE_DIR"/}")
